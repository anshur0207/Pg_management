# Create a Supabase project at https://supabase.com and add its public project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.

# Server-only credentials (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Optional resident rent collection through Razorpay (keys must match the configured Razorpay account).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
